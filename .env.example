# =============================================================================
# TinyTales World – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tinytales
POSTGRES_USER=tinytales_user
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cloud Storage ---
STORAGE_PROVIDER=local          # local | s3 | gcs
S3_BUCKET_NAME=tinytales-videos
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM Provider ---
LLM_PROVIDER=openai             # openai | anthropic | mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o

# --- Image Generation ---
IMAGE_PROVIDER=openai           # openai | stability | mock
STABILITY_API_KEY=
IMAGE_MODEL=dall-e-3

# --- Video Generation ---
VIDEO_PROVIDER=runway           # runway | pika | mock
RUNWAY_API_KEY=
PIKA_API_KEY=

# --- Text-to-Speech ---
TTS_PROVIDER=elevenlabs         # elevenlabs | google | mock
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# --- Music Generation ---
MUSIC_PROVIDER=suno             # suno | udio | mock
SUNO_API_KEY=
UDIO_API_KEY=

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback
YOUTUBE_CHANNEL_ID=

# --- Cost Limits ---
DAILY_COST_LIMIT_USD=50.00
MONTHLY_COST_LIMIT_USD=1000.00

# --- Scheduler ---
SCHEDULER_ENABLED=true
DAILY_VIDEO_TARGET=1
RESEARCH_CRON=0 8 * * *
PRODUCTION_CRON=30 8 * * *

# --- Nginx / Domain ---
DOMAIN=localhost
SSL_EMAIL=admin@example.com
